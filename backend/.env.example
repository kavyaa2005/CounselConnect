# Copy this file to `.env` and fill in the values.
#
#     cp .env.example .env          (macOS / Linux)
#     copy .env.example .env        (Windows)
#
# `.env` is gitignored. This file is committed on purpose so anyone cloning the
# repo can see which settings exist — it must never contain a real secret.

# ─────────────────────────── Server ───────────────────────────

PORT=5000
NODE_ENV=development

# Signs every login token. Any value works locally; production REFUSES TO START
# with the built-in fallback, because that fallback is public in this repo and
# anyone could use it to forge an admin token.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=7d

# Where the React app is served from. The API refuses browser requests from any
# other origin. Accepts several, comma-separated:
#   FRONTEND_URL=https://counselconnect.vercel.app,https://staging.example.com
FRONTEND_URL=http://localhost:5173

# ────────────────────────── Database ──────────────────────────

# Local MongoDB Community:
MONGODB_URI=mongodb://127.0.0.1:27017
# MongoDB Atlas looks like this instead — note the URL-encoded password:
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority

MONGODB_DB=counselconnect
MONGODB_TIMEOUT_MS=5000

# Unset: fatal in production, tolerated in development.
# true  = refuse to start if MongoDB is unreachable
# false = fall back to the JSON files in backend/data
# MONGODB_REQUIRED=true

# ────────────────────────── Payments ──────────────────────────

# Razorpay test keys from https://dashboard.razorpay.com → Account & Settings →
# API Keys. The key id is public and ships to the browser; the secret must stay
# on the server and must never be committed.
# Leave both blank to use the built-in simulated payment form instead.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ───────────────────────── Deployment ─────────────────────────

# Allow *.vercel.app preview builds through CORS. Set to false to allow only
# the exact URLs in FRONTEND_URL.
# ALLOW_VERCEL_PREVIEWS=true
